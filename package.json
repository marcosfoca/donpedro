{
  "name": "don-pedro-le-atiende",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync": "node scripts/sync-catalogo.mjs",
    "prebuild": "node -e \"require('fs').existsSync('scripts/sync-catalogo.mjs') ? require('child_process').execSync('node scripts/sync-catalogo.mjs', {stdio: 'inherit'}) : console.log('sync-catalogo: script no encontrado, se omite')\"",
    "build": "next build",
    "start": "serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "cheerio": "^1.1.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
